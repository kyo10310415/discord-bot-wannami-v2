# Server Configuration
PORT=3000
NODE_ENV=development

# SSO Authentication (WannaV Dashboard)
JWT_SECRET=your-shared-secret-key-here
DASHBOARD_URL=https://wannav-main.onrender.com
ADMIN_ROLES=admin,owner

# PostgreSQL（AI回答用ソース一覧）
DATABASE_URL=postgresql://user:password@host:5432/database
# Renderの同一リージョン内部URLではdisable。外部URLではrequire。
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
KNOWLEDGE_SOURCE_PROVIDER=database

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
BOT_USER_ID=your_bot_user_id_here

# OpenAI Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# 全文意味検索の埋め込みモデル（通常は変更不要）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32

# YouTube Data API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Sheets Configuration
KNOWLEDGE_BASE_SPREADSHEET_ID=your_spreadsheet_id_here
QA_SPREADSHEET_ID=your_qa_spreadsheet_id_here

# Google Service Account (for Google Sheets API)
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=your_client_id

# Discord Webhook (for Q&A weekly distribution)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Slack Webhook (for error notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
